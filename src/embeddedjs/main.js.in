import Poco from "commodetto/Poco";
import Message from "pebble/message";
import Vibes from "pebble/vibes";
// @if helper
// @else
import Battery from "embedded:sensor/Battery";
// @endif
// @if allowShakeDebugActionTestOnly
import Accelerometer from "embedded:sensor/Accelerometer";
// @endif
// @if helper
import Button from "pebble/button";
// @endif

// @if allowShakeDebugActionTestOnly
// Test builds only (allowShakeDebugActionTestOnly in watchface-config.json,
// Luped only): a shake sends this watch request: a signed bolus
// ("signedbolus:" or "signedforcedbolus:<units>[:<grams>]") is signed, anything
// else (such as "mute:<minutes>") is sent with its confirmation time. Off, none
// of this is built in.
const SHAKE_DEBUG_ACTION = "mute:30";
// @endif
// @if demoTestOnly
// Test builds only (demoTestOnly in watchface-config.json, Luped Remote only):
// no phone needed. Sample data and a test bolus key arrive at startup, the
// phone always counts as connected, and every request gets an "ok" answer
// after 3 s instead of being sent. Off, none of this is built in.
function demoReceive(face, entries) {
  const real = face.message;
  face.message = { read: () => entries };
  try {
    face.readMessages();
  } finally {
    face.message = real;
  }
}
// @endif

// @if helper
// Luped Remote (the lupedhelper variant) is a watchapp, so it gets the buttons.
// It closes itself back to the watchface after AUTO_CLOSE_SECONDS without a
// button press, but never while a request waits for the phone's RESULT
// (RESULT_TIMEOUT_MS at most).
const AUTO_CLOSE_SECONDS = 60;
const RESULT_TIMEOUT_MS = 30000;
// The confirmation chord: Up and Down (the top and bottom right buttons) both
// down within this many ms.
const CHORD_MS = 500;
// ...and then held together this long to send.
const HOLD_MS = 2000;
// What the user can ask the phone for (PROTOCOL.md, COMMAND). The phone sends
// the watch no preset names, so overrides and temp targets can only be ended.
const ACTIONS = [
  { id: "mute", label: "Mute alerts" },
  { id: "carbs", label: "Add carbs" },
  { id: "override", label: "End override" },
  { id: "temptarget", label: "End temp target" },
  { id: "bolus", label: "Bolus" },
  { id: "settings", label: "Settings" },
];
// The watch's own settings, kept in localStorage on the watch. Each value is one
// of its options; bolus is off until the user turns it on here.
const SETTINGS = [
  { id: "mute", label: "Mute", unit: "min", options: [15, 30, 60, 90, 120, 180, 240], value: 30 },
  { id: "carbStep", label: "Carb step", unit: "g", options: [1, 5, 10], value: 5 },
  { id: "carbMax", label: "Carb max", unit: "g", options: [10, 20, 30, 50, 75, 100], value: 50 },
  { id: "bolusStep", label: "Bolus step", unit: "U", options: [0.05, 0.1, 0.25, 0.5], value: 0.1 },
  { id: "bolusMax", label: "Bolus max", unit: "U", options: [0.5, 1, 2, 3, 5], value: 1 },
  { id: "allowBolus", label: "Allow bolus", options: [0, 1], value: 0 },
];

function setting(id) {
  return SETTINGS.find((item) => item.id === id).value;
}

function settingText(item, value) {
  return item.id === "allowBolus" ? (value ? "On" : "Off") : `${value} ${item.unit}`;
}

// @endif

// Signed bolus requests (PROTOCOL.md, Signed boluses): HMAC-SHA256 in plain
// JavaScript, as Alloy has no crypto module. Only run when the user asks for a
// bolus, so it favours size over speed.
// XS on the watch saturates unsigned 32-bit values (>>> 0 and Uint32Array give
// 2147483647 for anything from 2^31), so everything here stays signed: Int32Array,
// | 0, and >> with a mask. The bits are the same as the unsigned algorithm's.
// SHA-256 constants as signed 32-bit values, in typed arrays: one chunk each
// rather than a slot per element.
const SHA256_K = new Int32Array([
  1116352408, 1899447441, -1245643825, -373957723, 961987163, 1508970993, -1841331548,
  -1424204075, -670586216, 310598401, 607225278, 1426881987, 1925078388, -2132889090,
  -1680079193, -1046744716, -459576895, -272742522, 264347078, 604807628, 770255983, 1249150122,
  1555081692, 1996064986, -1740746414, -1473132947, -1341970488, -1084653625, -958395405,
  -710438585, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700,
  1986661051, -2117940946, -1838011259, -1564481375, -1474664885, -1035236496, -949202525,
  -778901479, -694614492, -200395387, 275423344, 430227734, 506948616, 659060556, 883997877,
  958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, -2067236844,
  -1933114872, -1866530822, -1538233109, -1090935817, -965641998,
]);
const SHA256_H = new Int32Array([
  1779033703, -1150833019, 1013904242, -1521486534, 1359893119, -1694144372, 528734635,
  1541459225,
]);
// Working buffers, reused by every hash (signing runs one hash at a time).
const SHA256_W = new Int32Array(64);
const SHA256_STATE = new Int32Array(8);

const ror = (x, n) => (x >>> n) | (x << (32 - n));

function sha256(data) {
  const padded = new Uint8Array(((data.length + 72) >> 6) << 6);
  padded.set(data);
  padded[data.length] = 0x80;
  const bits = data.length * 8;
  for (let i = 1; i <= 4; i++) padded[padded.length - i] = (bits >> (8 * (i - 1))) & 255;
  const h = SHA256_STATE;
  h.set(SHA256_H);
  const w = SHA256_W;
  for (let o = 0; o < padded.length; o += 64) {
    for (let i = 0; i < 16; i++)
      w[i] =
        (padded[o + 4 * i] << 24) |
        (padded[o + 4 * i + 1] << 16) |
        (padded[o + 4 * i + 2] << 8) |
        padded[o + 4 * i + 3];
    for (let i = 16; i < 64; i++) {
      const x = w[i - 15];
      const y = w[i - 2];
      w[i] =
        (w[i - 16] +
          (ror(x, 7) ^ ror(x, 18) ^ (x >>> 3)) +
          w[i - 7] +
          (ror(y, 17) ^ ror(y, 19) ^ (y >>> 10))) |
        0;
    }
    let a = h[0];
    let b = h[1];
    let c = h[2];
    let d = h[3];
    let e = h[4];
    let f = h[5];
    let g = h[6];
    let k = h[7];
    for (let i = 0; i < 64; i++) {
      const t1 =
        (k + (ror(e, 6) ^ ror(e, 11) ^ ror(e, 25)) + ((e & f) ^ (~e & g)) + SHA256_K[i] + w[i]) |
        0;
      const t2 = ((ror(a, 2) ^ ror(a, 13) ^ ror(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))) | 0;
      k = g;
      g = f;
      f = e;
      e = (d + t1) | 0;
      d = c;
      c = b;
      b = a;
      a = (t1 + t2) | 0;
    }
    h[0] = (h[0] + a) | 0;
    h[1] = (h[1] + b) | 0;
    h[2] = (h[2] + c) | 0;
    h[3] = (h[3] + d) | 0;
    h[4] = (h[4] + e) | 0;
    h[5] = (h[5] + f) | 0;
    h[6] = (h[6] + g) | 0;
    h[7] = (h[7] + k) | 0;
  }
  const out = new Uint8Array(32);
  for (let i = 0; i < 32; i++) out[i] = (h[i >> 2] >> (24 - 8 * (i & 3))) & 255;
  return out;
}

// The key's inner and outer padded blocks for HMAC, prepared once when the
// phone sends the key, so signing doesn't redo them. Keys longer than a block
// are hashed first, as HMAC requires.
function hmacKey(key) {
  const block = new Uint8Array(64);
  block.set(key.length > 64 ? sha256(key) : key);
  const inner = new Uint8Array(64);
  const outer = new Uint8Array(64);
  for (let i = 0; i < 64; i++) {
    inner[i] = block[i] ^ 0x36;
    outer[i] = block[i] ^ 0x5c;
  }
  return { inner, outer };
}

function hmacSha256(key, message) {
  const inner = new Uint8Array(64 + message.length);
  inner.set(key.inner);
  inner.set(message, 64);
  const outer = new Uint8Array(96);
  outer.set(key.outer);
  outer.set(sha256(inner), 64);
  return sha256(outer);
}

function asciiBytes(text) {
  const bytes = new Uint8Array(text.length);
  for (let i = 0; i < text.length; i++) bytes[i] = text.charCodeAt(i);
  return bytes;
}

function hexBytes(hex) {
  const bytes = new Uint8Array(hex.length >> 1);
  for (let i = 0; i < bytes.length; i++) bytes[i] = parseInt(hex.substr(2 * i, 2), 16);
  return bytes;
}

// Lowercase hex in one string, not one string per byte.
function bytesHex(bytes) {
  const codes = new Array(bytes.length * 2);
  for (let i = 0; i < bytes.length; i++) {
    const high = bytes[i] >> 4;
    const low = bytes[i] & 15;
    codes[2 * i] = high < 10 ? 48 + high : 87 + high;
    codes[2 * i + 1] = low < 10 ? 48 + low : 87 + low;
  }
  return String.fromCharCode.apply(null, codes);
}

// The MAC the phone expects: the first 16 bytes, as hex. `key` is from `hmacKey`.
function bolusMac(key, canonical) {
  return bytesHex(hmacSha256(key, asciiBytes(canonical)).subarray(0, 16));
}

// @if helper
// Luped Remote runs for a minute at a time, so it has no battery sampling,
// diagnostics or telemetry: its code alone takes app heap from PebbleOS.
// @else
const BATTERY_SAMPLE_INTERVAL_MS = 5 * 60 * 1000;
const DIAGNOSTICS_INTERVAL_MS = 60 * 60 * 1000;
// Grace period to let diagnostics ride an already-outgoing message before
// forcing a dedicated radio wake-up for telemetry alone.
const DIAGNOSTICS_PIGGYBACK_GRACE_MS = 15 * 60 * 1000;

const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
// @endif

// Trend-arrow stroke tables are constant; keep them out of the per-draw path.
const ARROW_GLYPHS = {
  DoubleUp: [
    [-6, 13, -6, -4, -6, -14, 6],
    [6, 13, 6, -4, 6, -14, 6],
  ],
  SingleUp: [[0, 15, 0, -3, 0, -16, 9]],
  FortyFiveUp: [[-12, 12, 2, -2, 13, -13, 8]],
  Flat: [[-15, 0, 3, 0, 16, 0, 9]],
  FortyFiveDown: [[-12, -12, 2, 2, 13, 13, 8]],
  SingleDown: [[0, -15, 0, 3, 0, 16, 9]],
  DoubleDown: [
    [-6, -13, -6, 4, -6, 14, 6],
    [6, -13, 6, 4, 6, 14, 6],
  ],
};

function vibe() {
  const p = [300];
  let n = 8;
  while (n > 0) {
    p.push(100, 50, 100, 300);
    n -= 1;
  }
  Vibes.pattern(p);
}

class CrimsonBearWatchface {
  // Lifecycle and shared state

  constructor() {
    this.render = new Poco(screen);
    this.fonts = {
      glucose: new this.render.Font("Bitham-Medium", 42),
      delta: new this.render.Font("Gothic-Bold", 24),
      label: new this.render.Font("Gothic-Regular", 18),
      status: new this.render.Font("Gothic-Regular", 14),
      footer: new this.render.Font("Bitham-Black", 30),
      fullGlucose: new this.render.Font("Bitham-Bold", 42),
      fullDelta: new this.render.Font("Bitham-Black", 30),
      fullLabel: new this.render.Font("Gothic-Bold", 24),
    };
    this.colors = {
      ink: this.render.makeColor(@COLOR_INK@),
      ringBorder: this.render.makeColor(@COLOR_RING_BORDER@),
      crimson: this.render.makeColor(@COLOR_ACCENT@),
      graph: this.render.makeColor(@COLOR_GRAPH@),
      panel: this.render.makeColor(@COLOR_PANEL@),
      pale: this.render.makeColor(@COLOR_PALE@),
      white: this.render.makeColor(255, 255, 255),
      bluetooth: this.render.makeColor(0, 128, 255),
      low: this.render.makeColor(@COLOR_LOW@),
      high: this.render.makeColor(@COLOR_HIGH@),
      // The warning screen's background: dark red, not the accent (Luped's is a
      // light green), so its white text reads.
      warning: this.render.makeColor(170, 0, 0),
      // Loop's status ring: fresh, aging, stale (LoopCompletionFreshness).
      loop: [
        this.render.makeColor(0, 170, 0),
        this.render.makeColor(255, 170, 0),
        this.render.makeColor(255, 0, 0),
      ],
      dim: this.render.makeColor(170, 170, 170),
    };
    this.state = {
      glucose: null,
      delta: null,
      direction: "NONE",
      readings: [],
      units: "mg/dL",
      low: 70,
      high: 180,
      updated: 0,
      configured: false,
      fullScreen: false,
      hostAlertState: 0,
      error: null,
      battery: 100,
    };
    this.configurationKnown = false;
    this.stale = false;
    this.lastDataSignature = null;
    this.footerState = {
      clock: null,
      date: null,
      battery: null,
      batteryWidth: 0,
      clockWidth: 0,
      connected: null,
    };
    this.pendingMinuteDate = null;
    this.pendingFullRender = false;
    this.pendingMinuteRender = false;
    this.pendingRenderDelay = 0;
    this.renderTimer = null;
    this.renderBusy = false;
    this.renderRetryCount = 0;
    this.lastRenderedFullScreen = null;
    this.refreshPending = true;
    this.lastRefreshRequestedAt = 0;
    this.refreshStartedAt = 0;
    this.isConnected = false;
    // @if helper
    // @else
    this.phoneDisconnectedAt = 0;
    this.telemetryPending = false;
    this.telemetryDueAt = 0;
    this.lastTelemetrySentAt = Date.now();
    this.lastBatterySampleAt = 0;
    this.lastMinuteEventAt = 0;
    this.startupId = Date.now();
    this.diagnostics = this.newDiagnostics();
    // @endif
    this.hasRenderedConfiguredFace = false;
    // @if helper
    this.view = "main";
    this.menuIndex = 0;
    this.secondsLeft = AUTO_CLOSE_SECONDS;
    this.fonts.bold = new this.render.Font("Gothic-Bold", 18);
    for (const item of SETTINGS) {
      try {
        const stored = localStorage.getItem(`setting.${item.id}`);
        if (stored != null && item.options.includes(Number(stored))) item.value = Number(stored);
      } catch (_) {
        // Defaults when storage is unavailable.
      }
    }
    // @endif
  }

  start() {
    this.draw();
    // @if helper
    // @else
    this.startBatteryService();
    // @endif
    this.startMessageService();
    watch.addEventListener("connected", () => this.checkConnection());
    this.checkConnection();
    watch.addEventListener("minutechange", (event) => this.drawMinute(event));
    // @if allowShakeDebugActionTestOnly
    this.shake = new Accelerometer({ onTap: () => this.requestShakeDebugAction() });
    // @endif
    // @if helper
    // pebble/button (Moddable's Pebble module; watchfaces may not import it)
    // subscribes the app window's click handlers. Up and Down repeat while held,
    // for the amount pickers. Taking Back means the app exits itself on Back.
    this.upDown = new Button({
      types: ["up", "down"],
      single: { repeat: 150 },
      onPush: (pushed, button) => pushed && this.helperPress(button),
    });
    this.selectBack = new Button({
      types: ["select", "back"],
      single: true,
      onPush: (pushed, button) => pushed && this.helperPress(button),
    });
    // Raw presses and releases of Up and Down, for the confirmation chord (both
    // held at once).
    this.held = {};
    this.chord = new Button({
      types: ["up", "down"],
      raw: true,
      onPush: (pushed, button) => this.helperRaw(pushed, button),
    });
    watch.addEventListener("secondchange", () => this.helperTick());
    // @else
    // A system pop-up (notification, alarm, call) covering the watchface. A
    // buzz it covers within its 4.7 s gets the delay as its outcome.
    watch.addEventListener("willFocus", (focused) => {
      this.coveredAt = focused ? 0 : Date.now();
      if (focused) return;
      this.countDiagnostic("popups");
      const buzz = this.diagnostics.buzzes[this.diagnostics.buzzes.length - 1];
      if (buzz && buzz[3] < 0 && this.coveredAt - buzz[2] < 4700)
        buzz[3] = this.coveredAt - buzz[2] || 1;
    });
    // @endif
    // @if demoTestOnly
    setTimeout(() => {
      const now = Date.now();
      const readings = [5.4, 5.5, 5.7, 5.8, 6, 6.1, 6.2, 6.3, 6.5, 6.6, 6.7, 6.8];
      const data = [1, 6.8, 0.2, 3, readings, 1, now, 0, 0, 0, 1.25, 12, now - 120000, 1, null, "test data"];
      demoReceive(this, [
        ["CONFIGURED", 1],
        ["COMMAND", "auth:v1:test:000102030405060708090a0b0c0d0e0f"],
        ["DATA", JSON.stringify(data)],
      ]);
    }, 500);
    // @endif
    watch.addEventListener("resize", () => {
      this.hasRenderedConfiguredFace = false;
      this.lastRenderedFullScreen = null;
      this.footerState = {
        clock: null,
        date: null,
        battery: null,
        batteryWidth: 0,
        clockWidth: 0,
        connected: null,
      };
      this.draw();
    });
  }

  // Value formatting and text primitives

  text(value, font, color, x, y, centered = false) {
    const string = String(value);
    const left = centered ? x - (this.render.getTextWidth(string, font) >> 1) : x;
    this.render.drawText(string, font, color, left, y);
  }

  // Luped has no thresholds: the host's active glucose alert (DATA index 8,
  // negative while Watch Alarms is off) colours the current glucose: red for
  // low and urgent low, amber for high, green otherwise.
  glucoseColor() {
    const alert = Math.abs(Number(this.state.hostAlertState) || 0);
    return alert === 1 || alert === 2 ? this.colors.low : alert === 3 ? this.colors.high : this.colors.crimson;
  }

  glucoseText() {
    if (this.stale) return "ERR";
    if (this.state.glucose == null) return "--";
    return this.state.units === "mmol/L"
      ? Number(this.state.glucose).toFixed(1)
      : String(this.state.glucose);
  }

  deltaText() {
    if (this.stale) return "";
    if (this.state.delta == null) return "--";
    const value =
      this.state.units === "mmol/L"
        ? Number(this.state.delta).toFixed(1)
        : String(this.state.delta);
    return `${this.state.delta > 0 ? "+" : ""}${value}`;
  }

  // Runtime diagnostics

  // @if helper
  // None in Luped Remote; shared code still counts.
  countDiagnostic() {}

  recordDraw() {}

  // @else
  newDiagnostics() {
    return {
      startedAt: Date.now(),
      startupId: this.startupId,
      fullDraws: 0,
      fullDrawMs: 0,
      fullDrawMaxMs: 0,
      minuteDraws: 0,
      minuteDrawMs: 0,
      minuteDrawMaxMs: 0,
      renderFailures: 0,
      renderRetries: 0,
      dataMessages: 0,
      refreshRequests: 0,
      refreshDeferred: 0,
      staleTransitions: 0,
      staleAlarms: 0,
      staleAgeMaxMs: 0,
      phoneDisconnects: 0,
      phoneDisconnectedMs: 0,
      phoneDisconnectedMaxMs: 0,
      incomingMessages: 0,
      incomingBytes: 0,
      outgoingMessages: 0,
      outgoingBytes: 0,
      refreshResponses: 0,
      refreshResponseMs: 0,
      refreshResponseMaxMs: 0,
      refreshResponseLatencyBuckets: [0, 0, 0, 0, 0, 0, 0, 0],
      invalidatedPixels: 0,
      lateMinuteEvents: 0,
      minuteEventLateMs: 0,
      minuteEventLateMaxMs: 0,
      popups: 0,
      silentAlertEvents: 0,
      buzzes: [],
    };
  }

  ensureDiagnosticsWindow() {
    if (Date.now() - this.diagnostics.startedAt >= 48 * 60 * 60 * 1000)
      this.diagnostics = this.newDiagnostics();
  }

  countDiagnostic(name) {
    this.addDiagnostic(name, 1);
  }

  addDiagnostic(name, amount) {
    this.ensureDiagnosticsWindow();
    this.diagnostics[name] = Number(this.diagnostics[name] || 0) + amount;
  }

  recordDraw(type, startedAt, invalidatedPixels) {
    this.ensureDiagnosticsWindow();
    const elapsed = Math.max(0, Date.now() - startedAt);
    const countKey = `${type}Draws`;
    const totalKey = `${type}DrawMs`;
    const maxKey = `${type}DrawMaxMs`;
    this.diagnostics[countKey] += 1;
    this.diagnostics[totalKey] += elapsed;
    this.diagnostics[maxKey] = Math.max(this.diagnostics[maxKey], elapsed);
    this.diagnostics.invalidatedPixels += invalidatedPixels;
  }

  diagnosticsSnapshot() {
    this.ensureDiagnosticsWindow();
    const d = this.diagnostics;
    const activeDisconnectMs = this.phoneDisconnectedAt
      ? Math.max(0, Date.now() - this.phoneDisconnectedAt)
      : 0;
    return [
      2,
      Date.now(),
      this.state.battery,
      d.startedAt,
      d.startupId,
      d.fullDraws,
      d.fullDrawMs,
      d.fullDrawMaxMs,
      d.minuteDraws,
      d.minuteDrawMs,
      d.minuteDrawMaxMs,
      d.renderFailures,
      d.renderRetries,
      d.dataMessages,
      d.refreshRequests,
      d.refreshDeferred,
      // On-watch threshold alarms are CrimsonBear only.
      0,
      0,
      0,
      d.incomingMessages,
      d.incomingBytes,
      d.outgoingMessages,
      d.outgoingBytes,
      d.refreshResponses,
      d.refreshResponseMs,
      d.refreshResponseMaxMs,
      d.invalidatedPixels,
      d.lateMinuteEvents,
      d.minuteEventLateMs,
      d.minuteEventLateMaxMs,
      d.refreshResponseLatencyBuckets,
      d.staleTransitions,
      d.staleAlarms,
      d.staleAgeMaxMs,
      d.phoneDisconnects,
      d.phoneDisconnectedMs + activeDisconnectMs,
      Math.max(d.phoneDisconnectedMaxMs, activeDisconnectMs),
      this.isConnected ? 0 : 1,
      d.popups,
      d.buzzes,
      d.silentAlertEvents,
    ];
  }

  recordLatency(buckets, elapsed) {
    const limits = [250, 500, 1000, 2000, 5000, 10000, 20000];
    let index = limits.findIndex((limit) => elapsed <= limit);
    if (index < 0) index = limits.length;
    buckets[index] += 1;
  }

  resetDiagnostics() {
    this.diagnostics = this.newDiagnostics();
    this.lastMinuteEventAt = 0;
    this.lastTelemetrySentAt = Date.now();
    this.telemetryPending = false;
    this.telemetryDueAt = 0;
    this.phoneDisconnectedAt = this.isConnected ? 0 : Date.now();
  }

  // @endif
  // Glucose and trend drawing primitives

  drawGlucose(cx, y, font = this.fonts.glucose) {
    const color = this.stale ? this.colors.low : this.glucoseColor(this.state.glucose);
    const value = this.glucoseText();
    if (this.stale || this.state.units !== "mmol/L" || this.state.glucose == null) {
      this.text(value, font, color, cx, y, true);
      return;
    }

    const [whole, fraction] = value.split(".");
    const wholeWidth = this.render.getTextWidth(whole, font);
    const fractionWidth = this.render.getTextWidth(fraction, font);
    const decimalWidth = 9;
    const left = Math.round(cx - (wholeWidth + decimalWidth + fractionWidth) / 2);
    this.text(whole, font, color, left, y);
    this.render.drawCircle(color, left + wholeWidth + 4, y + 34, 3, 0, 360);
    this.text(fraction, font, color, left + wholeWidth + decimalWidth, y);
  }

  arrow(cx, cy, direction, color, scale = 1) {
    const glyph = ARROW_GLYPHS[direction];
    if (!glyph) {
      this.text("?", this.fonts.delta, color, cx, cy - 12, true);
      return;
    }

    const point = (value) => Math.round(value * scale);
    const shaftWidth = Math.max(5, point(glyph.length > 1 ? 5 : 7));
    for (const [sx, sy, bx, by, tx, ty, headRadius] of glyph) {
      this.render.drawLine(
        cx + point(sx),
        cy + point(sy),
        cx + point(bx),
        cy + point(by),
        color,
        shaftWidth
      );

      const vx = tx - bx;
      const vy = ty - by;
      const length = Math.sqrt(vx * vx + vy * vy);
      const px = -vy / length;
      const py = vx / length;
      const steps = Math.max(6, point(length));
      for (let step = 0; step <= steps; step += 1) {
        const progress = step / steps;
        const centerX = bx + vx * progress;
        const centerY = by + vy * progress;
        const halfWidth = headRadius * (1 - progress);
        this.render.drawLine(
          cx + point(centerX - px * halfWidth),
          cy + point(centerY - py * halfWidth),
          cx + point(centerX + px * halfWidth),
          cy + point(centerY + py * halfWidth),
          color,
          2
        );
      }
    }
  }

  // @if helper
  // @else
  // Trend graph

  graphDomain() {
    const mmol = this.state.units === "mmol/L";
    const margin = mmol ? 1.1 : 20;
    const floor = mmol ? 2.2 : 40;
    const ceiling = mmol ? 22.2 : 400;
    // No thresholds: scale to the readings, a margin above and below and at
    // least two margins tall so a flat line doesn't fill the graph.
    const minimum = Math.max(floor, Math.min(...this.state.readings) - margin);
    const maximum = Math.min(ceiling, Math.max(Math.max(...this.state.readings) + margin, minimum + 2 * margin));
    return { minimum, maximum };
  }

  graphPoint(value, index, count, bounds, minimum, maximum) {
    return {
      x: Math.round(
        bounds.x + (count < 2 ? bounds.width : (index * bounds.width) / (count - 1))
      ),
      y: Math.round(
        bounds.y +
          bounds.height -
          ((value - minimum) / Math.max(1, maximum - minimum)) * bounds.height
      ),
    };
  }

  graph(x, y, width, height) {
    this.render.fillRectangle(this.colors.panel, x, y, width, height);
    const values = this.state.readings;
    if (!values.length) {
      this.text(
        this.state.error || "Waiting for CGM",
        this.fonts.label,
        this.colors.ink,
        x + width / 2,
        y + height / 2 - 10,
        true
      );
      return;
    }

    const bounds = {
      x: x + 8,
      y: y + 7,
      width: width - 16,
      height: height - 14,
    };
    const { minimum, maximum } = this.graphDomain();
    const points = values.map((value, index) =>
      this.graphPoint(value, index, values.length, bounds, minimum, maximum)
    );
    for (let index = 1; index < points.length; index += 1) {
      this.render.drawLine(
        points[index - 1].x,
        points[index - 1].y,
        points[index].x,
        points[index].y,
        this.colors.graph,
        3
      );
    }
    points.forEach((point, index) => {
      const latest = index === points.length - 1;
      this.render.drawCircle(
        latest ? this.colors.ink : this.colors.white,
        point.x,
        point.y,
        latest ? 6 : 4,
        0,
        360
      );
      // Past readings have no alert state: one neutral colour.
      this.render.drawCircle(
        this.colors.graph,
        point.x,
        point.y,
        latest ? 4 : 2,
        0,
        360
      );
    });
  }

  // Background and setup-state layouts

  // An open loop opens the ring at the top like Loop's own status ring: a 90°
  // gap (LoopCircleView trims a quarter). Only the gap's wedge is cleared, 2 px
  // wider than the ring so no anti-aliased edge of a closed ring drawn earlier
  // stays in it (clearing the whole disc would paint over the status strip
  // below), and the dark border stops short of the cuts so their ends are clean.
  drawVariantRing(cx, cy, radius, open = false) {
    const outerRadius = radius - 3;
    const ringWidth = Math.min(10, Math.max(9, Math.round(outerRadius * 0.12)));
    const glucose = Number(this.state.glucose);
    const ringColor = this.stale ? this.colors.graph : this.glucoseColor(glucose);
    const from = open ? 45 : 0;
    const edge = open ? 3 : 0;
    if (open) {
      this.render.drawCircle(this.colors.pale, cx, cy, outerRadius + 2, 0, from + 2);
      this.render.drawCircle(this.colors.pale, cx, cy, outerRadius + 2, 358 - from, 360);
    }
    this.render.drawCircle(this.colors.ringBorder, cx, cy, outerRadius, from + edge, 360 - from - edge);
    this.render.drawCircle(ringColor, cx, cy, outerRadius - 1, from, 360 - from);
    this.render.drawCircle(this.colors.pale, cx, cy, outerRadius - ringWidth, 0, 360);
    this.render.drawCircle(
      this.colors.white,
      cx,
      cy,
      outerRadius - ringWidth - 2,
      0,
      360
    );
  }

  // @endif
  // Shown instead of any data: the phone speaks a newer protocol (update the
  // face), or another phone app took over the watch (restart the face).
  warningScreen(width, height) {
    const center = width >> 1;
    const [title, detail, action] = this.newProtocol
      ? ["UPDATE NEEDED", `Phone sends v${this.newProtocol}`, "Update this"]
      : ["APP CHANGED", `${this.hostChange[0]} to ${this.hostChange[1]}`, "Restart this"];
    this.render.fillRectangle(this.colors.warning, 0, 0, width, height);
    this.text("!", this.fonts.glucose, this.colors.white, center, 26, true);
    this.text(title, this.fonts.delta, this.colors.white, center, 91, true);
    this.text(detail, this.fonts.label, this.colors.white, center, 126, true);
    this.text(action, this.fonts.label, this.colors.white, center, 156, true);
    // @if helper
    this.text("app", this.fonts.label, this.colors.white, center, 178, true);
    // @else
    this.text("watchface", this.fonts.label, this.colors.white, center, 178, true);
    // @endif
  }

  setupScreen(width, height) {
    const center = width >> 1;
    const phoneWidth = 42;
    const phoneHeight = 62;
    const phoneX = center - (phoneWidth >> 1);
    const phoneY = 20;
    this.render.fillRectangle(this.colors.ink, 0, 0, width, height);
    this.render.fillRectangle(
      this.colors.white,
      phoneX,
      phoneY,
      phoneWidth,
      phoneHeight
    );
    this.render.fillRectangle(
      this.colors.crimson,
      phoneX + 3,
      phoneY + 3,
      phoneWidth - 6,
      phoneHeight - 9
    );
    this.render.fillRectangle(
      this.colors.ink,
      center - 3,
      phoneY + phoneHeight - 4,
      6,
      2
    );
    this.text("!", this.fonts.glucose, this.colors.white, center, phoneY + 6, true);
    this.text("SET UP REQUIRED", this.fonts.delta, this.colors.white, center, 91, true);
    this.text(
      @SETUP_APP_TEXT@,
      this.fonts.label,
      this.colors.pale,
      center,
      126,
      true
    );
    this.text("on your phone", this.fonts.label, this.colors.pale, center, 148, true);
    this.text(
      @SETTINGS_TEXT@,
      this.fonts.label,
      this.colors.white,
      center,
      178,
      true
    );
    this.text(
      @SETUP_ACTION_TEXT@,
      this.fonts.label,
      this.colors.white,
      center,
      199,
      true
    );
  }

  connectingScreen(width, height) {
    const center = width >> 1;
    this.render.fillRectangle(this.colors.ink, 0, 0, width, height);
    this.text("CONNECTING", this.fonts.delta, this.colors.white, center, 84, true);
    // @if helper
    this.text("Waiting for CGM from", this.fonts.label, this.colors.pale, center, 122, true);
    this.text("Loop, Trio or similar", this.fonts.label, this.colors.pale, center, 144, true);
    // @else
    this.text("Waiting for CGM", this.fonts.label, this.colors.pale, center, 122, true);
    // @endif
  }

  // Shared status and age elements

  readingTime() {
    const updated = Number(this.state.updated);
    if (!Number.isFinite(updated) || updated <= 0) return "--:--";
    const date = new Date(updated);
    return `${String(date.getHours()).padStart(2, "0")}:${String(
      date.getMinutes()
    ).padStart(2, "0")}`;
  }

  // @if helper
  // Luped Remote's screens, one at a time, in Luped's palette: a header with
  // the clock and the auto-close countdown, then the main screen (reading, IOB
  // and COB, one status line, the action list), an amount picker, a
  // confirmation or the watch's settings. Until the phone has answered,
  // Luped's connecting, setup and warning screens show instead.
  face() {
    const { width, height } = this.render;
    const header = this.helperHeaderHeight();
    const top = header + (screen.round ? 4 : 2);
    if (this.hostChange || this.newProtocol) this.warningScreen(width, height);
    else if (!this.configurationKnown) this.connectingScreen(width, height);
    else if (!this.state.configured) this.setupScreen(width, height);
    else {
      this.render.fillRectangle(this.colors.pale, 0, 0, width, height);
      if (this.view === "amount") this.helperAmount(width, top);
      else if (this.view === "confirm") this.helperConfirm(width, top);
      else if (this.view === "settings") this.helperSettings(width, top);
      else if (this.view === "sending" && this.pending) this.helperSending(width, top);
      else if (this.view === "result" && this.result) this.helperOutcome(width, top);
      else this.helperMain(width, top);
    }
    this.helperHeader(width, header);
  }

  helperHeaderHeight() {
    return screen.round ? 30 : 22;
  }

  // The once-a-second repaint: the header only, not the whole screen.
  helperDrawHeader() {
    const { width } = this.render;
    const header = this.helperHeaderHeight();
    let began = false;
    try {
      this.render.begin(0, 0, width, header);
      began = true;
      this.helperHeader(width, header);
      began = false;
      this.render.end();
    } catch (_) {
      if (began) this.render.end();
      this.draw();
    }
  }

  // The clock (not on round, whose top is too narrow for both) and the seconds
  // left before the app closes, over a thin bar that shrinks with them (amber
  // and full while a request waits for the phone).
  helperHeader(width, header) {
    const { ink, white } = this.colors;
    const left = this.pending ? "Auto exit paused" : `Auto exit ${this.secondsLeft}s`;
    const y = header - 20;
    this.render.fillRectangle(ink, 0, 0, width, header);
    if (screen.round) this.text(left, this.fonts.bold, white, width >> 1, y, true);
    else {
      const now = new Date();
      this.text(`${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`, this.fonts.bold, white, 6, y);
      this.text(left, this.fonts.bold, white, width - 6 - this.render.getTextWidth(left, this.fonts.bold), y);
    }
    const barWidth = this.pending ? width : Math.round((width * this.secondsLeft) / AUTO_CLOSE_SECONDS);
    this.render.fillRectangle(this.pending ? this.colors.high : this.colors.crimson, 0, header - 3, barWidth, 3);
  }

  // The status line: a request waiting or its answer, else the connection.
  // Returns the text and its band colour.
  helperStatus() {
    if (this.pending) return [`Sent ${this.pending.action}, waiting`, this.colors.high];
    if (this.result) {
      const [label, ok] = this.helperResultText();
      return [`${label}: ${ok ? "done" : "not done"}`, ok ? this.colors.panel : this.colors.low];
    }
    if (!this.isConnected) return ["No phone connection", this.colors.low];
    if (this.state.error) return [this.state.error, this.colors.low];
    if (this.stale) return ["No recent CGM data", this.colors.low];
    return [`Connected to ${this.host || "phone"}`, this.colors.panel];
  }

  // The answer in "<action>:<outcome>[:<reason>]" (PROTOCOL.md, RESULT) as the
  // action's label, whether it was done, the outcome in words and the phone's
  // reason (capitalized, or ""). Loop answers a bolus as signedbolus.
  helperResultText() {
    const [action, outcome = "", reason = ""] = this.result.split(":");
    const id = action.replace("signed", "").replace("forced", "");
    const label = (ACTIONS.find((item) => item.id === id) || { label: action }).label;
    const words = {
      ok: "The phone carried it out",
      refused: "The phone refused it",
      ignored: "Not offered by the phone",
      failed: "It failed on the phone",
      "no key": "Phone doesn't allow it",
    }[outcome];
    return [label, outcome === "ok", words || outcome, reason.charAt(0).toUpperCase() + reason.slice(1)];
  }

  // A small triangle pointing up (dir -1) or down (dir 1), for list scrolling.
  helperChevron(x, y, dir, color) {
    for (let i = 0; i < 5; i++) this.render.fillRectangle(color, x - i, y - dir * i, 2 * i + 1, 1);
  }

  helperMain(width, top) {
    const cx = width >> 1;
    const margin = screen.round ? 24 : 6;
    const { ink, white } = this.colors;
    // Glucose in the host's units and Luped's alert colour, the trend arrow,
    // the delta and the reading's time.
    const glucoseWidth = this.render.getTextWidth(this.glucoseText(), this.fonts.fullGlucose);
    const glucoseX = cx - 16;
    this.drawGlucose(glucoseX, top - 4, this.fonts.fullGlucose);
    if (!this.stale && this.state.glucose != null)
      this.arrow(glucoseX + (glucoseWidth >> 1) + 26, top + 20, this.state.direction, this.colors.crimson, 0.8);
    const y = top + 42;
    this.text(`${this.deltaText()} ${this.state.units}`, this.fonts.bold, ink, margin, y + 4);
    const time = this.readingTime();
    this.text(time, this.fonts.delta, ink, width - margin - this.render.getTextWidth(time, this.fonts.delta), y);
    // IOB and COB as Luped's status strip shows them (or the phone's own line),
    // dimmed once the loop is stale.
    const { iob, cob } = this.state;
    const loop = [iob == null ? "" : `IOB ${Number(iob).toFixed(1)} U`, cob == null ? "" : `COB ${Math.round(cob)} g`]
      .filter(Boolean)
      .join("    ");
    const line = loop || String(this.state.statusLine || "").replace("\t", "  ");
    this.text(line, this.fonts.bold, this.loopFreshness() > 1 ? this.colors.dim : ink, cx, y + 26, true);
    const [status, band] = this.helperStatus();
    this.render.fillRectangle(band, 0, y + 50, width, 22);
    this.text(status, this.fonts.bold, band === this.colors.low ? white : ink, cx, y + 51, true);
    // Three rows of the action list; the highlighted one is an ink bar with an
    // accent edge, and triangles show when there is more above or below.
    const actions = this.helperActions();
    const first = Math.max(0, Math.min(this.menuIndex - 1, actions.length - 3));
    const listY = y + 76;
    for (let row = 0; row < 3 && first + row < actions.length; row++) {
      const index = first + row;
      const rowY = listY + row * 28;
      const selected = index === this.menuIndex;
      if (selected) {
        this.render.fillRectangle(ink, margin, rowY, width - 2 * margin, 28);
        this.render.fillRectangle(this.colors.crimson, margin, rowY, 5, 28);
      }
      // Remote actions are dimmed (and refused) without a phone connection, and
      // Bolus also without the phone's bolus key.
      const usable = this.helperUsable(actions[index].id);
      this.text(actions[index].label, this.fonts.fullLabel, !usable ? this.colors.dim : selected ? white : ink, cx, rowY, true);
    }
    const chevronX = width - margin - 10;
    if (first > 0) this.helperChevron(chevronX, listY + 9, -1, this.colors.graph);
    if (first + 3 < actions.length) this.helperChevron(chevronX, listY + 74, 1, this.colors.graph);
  }

  // A large number, with the decimal point drawn as Luped draws glucose (the
  // Bitham font has digits only).
  helperNumber(value, cx, y) {
    const font = this.fonts.fullGlucose;
    const [whole, fraction] = String(value).split(".");
    const wholeWidth = this.render.getTextWidth(whole, font);
    const fractionWidth = fraction ? 9 + this.render.getTextWidth(fraction, font) : 0;
    const left = Math.round(cx - (wholeWidth + fractionWidth) / 2);
    this.text(whole, font, this.colors.ink, left, y);
    if (!fraction) return;
    this.render.drawCircle(this.colors.ink, left + wholeWidth + 4, y + 34, 3, 0, 360);
    this.text(fraction, font, this.colors.ink, left + wholeWidth + 9, y);
  }

  // A title band under the header: ink, amber (a bolus) or red (not done).
  helperTitle(width, top, title, color = this.colors.ink) {
    this.render.fillRectangle(color, 0, top - 2, width, 30);
    this.text(title, this.fonts.fullLabel, color === this.colors.high ? this.colors.ink : this.colors.white, width >> 1, top - 1, true);
  }

  // While a request waits for the phone's answer: what was sent and a wheel.
  helperSending(width, top) {
    const cx = width >> 1;
    const { ink } = this.colors;
    this.helperTitle(width, top, "Sending", this.pending.action === "bolus" ? this.colors.high : ink);
    this.pending.lines.forEach((line, index) =>
      this.text(line.replace("?", ""), this.fonts.fullLabel, ink, cx, top + 34 + index * 26, true)
    );
    this.helperWheelFill();
    const carbs = this.pending.carbs;
    const waiting = carbs == null ? "Waiting for the phone" : carbs === "ok" ? "Carbs added, bolus next" : "Carbs not added";
    this.text(waiting, this.fonts.bold, carbs != null && carbs !== "ok" ? this.colors.low : ink, cx, top + 150, true);
    this.text("Back: hide", this.fonts.bold, ink, cx, top + 182, true);
  }

  // The wheel's centre and radius on the sending screen.
  helperWheel() {
    return [this.render.width >> 1, this.helperHeaderHeight() + (screen.round ? 4 : 2) + 120, 16];
  }

  // A ring with a dark quarter that moves on by 30° every 100 ms.
  helperWheelFill() {
    const [cx, cy, r] = this.helperWheel();
    const start = this.wheelAngle || 0;
    this.render.fillRectangle(this.colors.pale, 0, cy - r - 1, this.render.width, 2 * r + 2);
    this.render.drawCircle(this.colors.panel, cx, cy, r, 0, 360);
    this.render.drawCircle(this.colors.ink, cx, cy, r, start, start + 90);
    this.render.drawCircle(this.colors.pale, cx, cy, r - 5, 0, 360);
  }

  // Turns the wheel, repainting only its strip; stops once the answer is in.
  helperSpin() {
    if (!this.pending || this.view !== "sending") {
      clearInterval(this.wheelTimer);
      this.wheelTimer = null;
      return;
    }
    this.wheelAngle = ((this.wheelAngle || 0) + 30) % 360;
    const [, cy, r] = this.helperWheel();
    let began = false;
    try {
      this.render.begin(0, cy - r - 1, this.render.width, 2 * r + 2);
      began = true;
      this.helperWheelFill();
      began = false;
      this.render.end();
    } catch (_) {
      if (began) this.render.end();
    }
  }

  // The phone's answer (or why there is none): done or not, and what.
  helperOutcome(width, top) {
    const cx = width >> 1;
    const cy = top + 66;
    const [label, ok, words, reason] = this.helperResultText();
    this.helperTitle(width, top, ok ? "Done" : "Not done", ok ? this.colors.ink : this.colors.low);
    if (ok) {
      this.render.drawLine(cx - 22, cy, cx - 6, cy + 16, this.colors.crimson, 7);
      this.render.drawLine(cx - 6, cy + 16, cx + 22, cy - 14, this.colors.crimson, 7);
    } else {
      this.render.drawLine(cx - 16, cy - 16, cx + 16, cy + 16, this.colors.low, 7);
      this.render.drawLine(cx - 16, cy + 16, cx + 16, cy - 16, this.colors.low, 7);
    }
    this.text(label, this.fonts.fullLabel, this.colors.ink, cx, top + 96, true);
    this.text(words, this.fonts.bold, this.colors.ink, cx, top + 126, true);
    if (reason) this.text(reason, this.fonts.bold, this.colors.low, cx, top + 150, true);
    this.text("Select: OK", this.fonts.bold, this.colors.ink, cx, top + 182, true);
  }

  helperAmount(width, top) {
    const cx = width >> 1;
    const { picker } = this;
    const ink = this.colors.ink;
    const margin = screen.round ? 34 : 14;
    const bolus = picker.action === "bolus" || picker.action === "bolusCarbs";
    this.helperTitle(width, top, picker.label, bolus ? this.colors.high : ink);
    this.render.fillRectangle(this.colors.panel, margin, top + 34, width - 2 * margin, 76);
    this.helperChevron(cx, top + 38, -1, ink);
    this.helperNumber(this.helperValue(), cx, top + 44);
    this.helperChevron(cx, top + 105, 1, ink);
    this.text(picker.unit, this.fonts.bold, ink, width - margin - 6 - this.render.getTextWidth(picker.unit, this.fonts.bold), top + 84);
    const range = picker.minCount === 0 ? `0: none, max` : `Step ${picker.step}, max`;
    this.text(`${range} ${this.helperValue(picker.maxCount)} ${picker.unit}`, this.fonts.bold, ink, cx, top + 116, true);
    this.text("Select: continue", this.fonts.bold, ink, cx, top + 146, true);
    this.text("Back: cancel", this.fonts.bold, ink, cx, top + 166, true);
  }

  helperConfirm(width, top) {
    const cx = width >> 1;
    const ink = this.colors.ink;
    const bolus = this.confirmation.action === "bolus";
    this.helperTitle(width, top, "Confirm", bolus ? this.colors.high : ink);
    this.confirmation.lines.forEach((line, index) =>
      this.text(line, this.fonts.fullLabel, ink, cx, top + 38 + index * 28, true)
    );
    // What a bolus or carbs rest on: the reading now and IOB, or a red
    // warning (for any action) when there is no recent reading.
    const twoLineBolus = bolus && this.confirmation.lines.length > 1;
    const contextY = bolus ? (twoLineBolus ? top + 94 : top + 66) : top + 98;
    if (this.stale || this.state.glucose == null)
      this.text("No recent CGM data", this.fonts.bold, this.colors.low, cx, contextY, true);
    else if (bolus || this.confirmation.action === "carbs") {
      const iob = this.state.iob == null ? "" : `, IOB ${Number(this.state.iob).toFixed(1)} U`;
      this.text(`${this.glucoseText()} ${this.state.units}${iob}`, this.fonts.bold, ink, cx, contextY, true);
    }
    if (bolus && !twoLineBolus) this.text("The phone checks its limits", this.fonts.bold, ink, cx, top + 98, true);
    const margin = screen.round ? 34 : 14;
    this.render.fillRectangle(this.colors.crimson, margin, top + 128, width - 2 * margin, 44);
    this.text("Hold top and bottom right", this.fonts.bold, ink, cx, top + 131, true);
    this.text("buttons for 2 s to send", this.fonts.bold, ink, cx, top + 149, true);
    this.helperHoldBarFill();
    this.text("Back: cancel", this.fonts.bold, ink, cx, top + 182, true);
  }

  helperSettings(width, top) {
    const cx = width >> 1;
    const margin = screen.round ? 28 : 4;
    const { ink, white } = this.colors;
    this.helperTitle(width, top, "Settings");
    SETTINGS.forEach((item, index) => {
      const y = top + 30 + index * 23;
      const selected = index === this.settingIndex;
      const editing = selected && this.editing != null;
      const value = editing ? `< ${settingText(item, item.options[this.editing])} >` : settingText(item, item.value);
      if (selected) {
        this.render.fillRectangle(editing ? this.colors.panel : ink, margin, y, width - 2 * margin, 23);
        this.render.fillRectangle(this.colors.crimson, margin, y, 5, 23);
      }
      this.text(`${item.label}: ${value}`, this.fonts.bold, selected && !editing ? white : ink, cx, y, true);
    });
    const hint = this.editing != null ? "Select: save  Back: undo" : "Select: change  Back: done";
    this.text(hint, this.fonts.bold, ink, cx, top + 32 + SETTINGS.length * 23, true);
  }

  // Whether an action can be opened now. The phone sends the bolus key only
  // while it takes boluses from the watch.
  helperUsable(id) {
    return id === "settings" || (this.isConnected && (id !== "bolus" || Boolean(this.bolusAuth)));
  }

  // Bolus shows in the list only while Allow bolus is on.
  helperActions() {
    return ACTIONS.filter((action) => action.id !== "bolus" || setting("allowBolus"));
  }

  // The picker's amount (or `count` steps of it), at most two decimals.
  helperValue(count = this.picker.count) {
    return Math.round(count * this.picker.step * 100) / 100;
  }

  // A request is sent only when Up and Down are both held down within CHORD_MS
  // of each other, on the confirmation screen.
  helperRaw(pushed, button) {
    const now = Date.now();
    if (!pushed) {
      delete this.held[button];
      if (this.chordAt && !Object.keys(this.held).length) this.chordDoneAt = now;
      // Letting go of either before the hold completes sends nothing.
      if (this.holdTimer) this.helperHoldEnd(false);
      return;
    }
    this.held[button] = now;
    const times = ["up", "down"].map((name) => this.held[name]);
    if (this.view !== "confirm" || times.some((time) => time == null || now - time > CHORD_MS)) return;
    this.chordAt = now;
    this.chordDoneAt = 0;
    this.secondsLeft = AUTO_CLOSE_SECONDS;
    this.holdStart = now;
    if (!this.holdTimer) this.holdTimer = setInterval(() => this.helperHoldStep(), 100);
  }

  // While both are held: fill the bar, and send once HOLD_MS is reached.
  helperHoldStep() {
    if (Date.now() - this.holdStart >= HOLD_MS) this.helperHoldEnd(true);
    else this.helperDrawHold();
  }

  helperHoldEnd(send) {
    clearInterval(this.holdTimer);
    this.holdTimer = null;
    this.holdStart = 0;
    if (!send || this.view !== "confirm") {
      if (this.view === "confirm") this.helperDrawHold();
      return;
    }
    this.helperSend();
    this.draw();
  }

  // The hold bar's place on the confirm screen.
  helperHoldBar() {
    const margin = screen.round ? 34 : 14;
    const top = this.helperHeaderHeight() + (screen.round ? 4 : 2);
    return [margin, top + 175, this.render.width - 2 * margin, 6];
  }

  // Paints the hold bar: filled by how long both have been held.
  helperHoldBarFill() {
    const [x, y, width, height] = this.helperHoldBar();
    const held = this.holdStart ? Math.min(1, (Date.now() - this.holdStart) / HOLD_MS) : 0;
    this.render.fillRectangle(this.colors.pale, 0, y, this.render.width, height);
    this.render.fillRectangle(this.colors.panel, x, y, width, height);
    this.render.fillRectangle(this.colors.ink, x, y, Math.round(width * held), height);
  }

  // Repaints only the hold bar (not the whole screen).
  helperDrawHold() {
    const [, y, , height] = this.helperHoldBar();
    let began = false;
    try {
      // A full-width strip: Poco may widen a narrower region.
      this.render.begin(0, y, this.render.width, height);
      began = true;
      this.helperHoldBarFill();
      began = false;
      this.render.end();
    } catch (_) {
      if (began) this.render.end();
    }
  }

  helperPress(button) {
    // A chord's own clicks arrive as its buttons are released: ignore clicks
    // until 300 ms after both are up (or 3 s, should a release get lost).
    if (this.chordAt) {
      const now = Date.now();
      if (now - this.chordAt < 3000 && (!this.chordDoneAt || now - this.chordDoneAt < 300)) return;
      this.chordAt = 0;
    }
    // Every press starts the minute before the app closes again.
    this.secondsLeft = AUTO_CLOSE_SECONDS;
    const move = button === "up" ? 1 : button === "down" ? -1 : 0;
    const select = button === "select";
    const back = button === "back";
    const view = this.hostChange || this.newProtocol || !this.state.configured ? "main" : this.view;
    if (view === "main") {
      // While a request waits (30 s at most), Back shows it again instead of
      // closing the app, so its answer isn't missed.
      if (back && this.pending) {
        this.view = "sending";
        if (!this.wheelTimer) this.wheelTimer = setInterval(() => this.helperSpin(), 100);
        this.draw();
        return;
      }
      if (back) {
        watch.exit();
        return;
      }
      const actions = this.helperActions();
      this.menuIndex = (this.menuIndex - move + actions.length) % actions.length;
      if (select && this.state.configured && !this.hostChange && !this.newProtocol)
        this.helperOpen(actions[this.menuIndex].id);
    } else if (view === "amount") {
      const { picker } = this;
      const min = picker.minCount == null ? 1 : picker.minCount;
      picker.count = Math.max(min, Math.min(picker.maxCount, picker.count + move));
      if (back) this.view = "main";
      if (select) {
        const value = this.helperValue();
        if (picker.action === "bolus") {
          // A bolus may come with carbs, which the phone adds first (and
          // gives no bolus if it can't): 0 g, the start, for none.
          const step = setting("carbStep");
          this.picker = {
            action: "bolusCarbs",
            units: value,
            label: "Carbs with bolus",
            unit: "g",
            step,
            count: 0,
            minCount: 0,
            maxCount: Math.max(1, Math.floor(setting("carbMax") / step + 1e-9)),
          };
        } else if (picker.action === "bolusCarbs") {
          const units = picker.units;
          const lines = value ? [`Bolus ${units} U`, `with ${value} g carbs?`] : [`Bolus ${units} U?`];
          this.helperConfirmation("bolus", value ? `signedbolus:${units}:${value}` : `signedbolus:${units}`, lines);
        } else {
          const lines = {
            mute: ["Mute alerts", `for ${value} min?`],
            carbs: [`Add ${value} g`, "of carbs?"],
          }[picker.action];
          this.helperConfirmation(picker.action, `${picker.action}:${value}`, lines);
        }
      }
    } else if (view === "confirm") {
      // Select alone doesn't send: only the Up+Down chord (helperRaw).
      if (back) this.view = "main";
    } else if (view === "sending" || view === "result") {
      // Back hides the wheel (the status line still shows the wait); Select
      // or Back closes the answer.
      if (back || (select && view === "result")) this.view = "main";
    } else if (view === "settings") {
      const item = SETTINGS[this.settingIndex];
      if (this.editing == null) {
        this.settingIndex = (this.settingIndex - move + SETTINGS.length) % SETTINGS.length;
        if (select) this.editing = item.options.indexOf(item.value);
        if (back) this.view = "main";
      } else {
        this.editing = Math.max(0, Math.min(item.options.length - 1, this.editing + move));
        if (select) {
          item.value = item.options[this.editing];
          try {
            localStorage.setItem(`setting.${item.id}`, String(item.value));
          } catch (_) {
            // Kept for this run only.
          }
        }
        if (select || back) this.editing = null;
        this.menuIndex = Math.min(this.menuIndex, this.helperActions().length - 1);
      }
    }
    this.draw();
  }

  helperOpen(id) {
    if (id === "settings") {
      this.view = "settings";
      this.settingIndex = 0;
      this.editing = null;
      return;
    }
    // Without the bolus key, say why on the answer screen.
    if (id === "bolus" && this.isConnected && !this.bolusAuth) {
      this.result = "bolus:no key";
      this.resultUntil = Date.now() + 60000;
      this.view = "result";
      Vibes.doublePulse();
      return;
    }
    // No remote action without a phone connection (the status line says so),
    // and one request at a time: the next waits for this one's answer.
    if (!this.helperUsable(id) || this.pending) {
      Vibes.doublePulse();
      return;
    }
    if (id === "override" || id === "temptarget") {
      const name = id === "override" ? "override?" : "temp target?";
      this.helperConfirmation(id, `${id}:cancel`, ["End the running", name]);
      return;
    }
    const step = id === "mute" ? 15 : setting(id === "carbs" ? "carbStep" : "bolusStep");
    const max = id === "mute" ? 240 : setting(id === "carbs" ? "carbMax" : "bolusMax");
    this.picker = {
      action: id,
      label: ACTIONS.find((action) => action.id === id).label,
      unit: id === "mute" ? "min" : id === "carbs" ? "g" : "U",
      step,
      count: id === "mute" ? setting("mute") / 15 : 1,
      maxCount: Math.max(1, Math.floor(max / step + 1e-9)),
    };
    this.view = "amount";
  }

  helperConfirmation(action, command, lines) {
    this.confirmation = { action, command, lines };
    this.view = "confirm";
  }

  // Sends the confirmed request (PROTOCOL.md, COMMAND); a bolus only signed,
  // with the phone's session key, and only while Allow bolus is on.
  helperSend() {
    const { action, command, lines } = this.confirmation;
    this.view = "result";
    this.confirmation = null;
    // The connection may have dropped while the confirmation showed.
    if (!this.isConnected) {
      this.result = `${action}:not sent, no phone`;
      this.resultUntil = Date.now() + 60000;
      Vibes.doublePulse();
      return;
    }
    if (action === "bolus" && (!setting("allowBolus") || !this.bolusAuth)) {
      if (setting("allowBolus")) this.requestSignedBolus(command); // "bolus: no key"
      else this.view = "main";
      return;
    }
    // A short buzz for "sent" (only now: a refusal above has its own double
    // buzz, and PebbleOS drops a buzz that starts while another plays).
    Vibes.shortPulse();
    this.result = null;
    this.view = "sending";
    this.pending = { action, lines, until: Date.now() + RESULT_TIMEOUT_MS };
    if (!this.wheelTimer) this.wheelTimer = setInterval(() => this.helperSpin(), 100);
    if (action === "bolus") this.requestSignedBolus(command);
    else {
      this.bolusCommand = `${command}@${Math.floor(Date.now() / 1000)}`;
      this.flushOutbound();
    }
  }

  // Once a second: the countdown (paused while a request waits for its answer),
  // the answer's timeout, and closing back to the watchface.
  helperTick() {
    const now = Date.now();
    let changed = false;
    if (this.pending && now >= this.pending.until) {
      changed = true;
      // Unsent requests are dropped; a sent one may still have been carried out.
      const sent = !this.bolusCommand;
      this.bolusCommand = null;
      this.result = `${this.pending.action}:${sent ? "no answer, check phone" : "not sent"}`;
      this.resultUntil = now + 60000;
      this.pending = null;
      this.view = "result";
      this.secondsLeft = Math.max(this.secondsLeft, 15);
      Vibes.doublePulse();
    }
    if (!this.pending) this.secondsLeft -= 1;
    if (this.secondsLeft <= 0) {
      // APP_EXIT_ACTION_PERFORMED_SUCCESSFULLY: back to the watchface, not the launcher.
      watch.exit(1);
      return;
    }
    // Only the header changes, unless the answer timed out.
    if (changed) this.draw();
    else this.helperDrawHeader();
  }

  // @else
  // A request's answer, "<action>:<outcome>" (PROTOCOL.md, RESULT), as its
  // label, its outcome ("done" for ok) and whether it was done. It may answer
  // Luped Remote after that app has closed; Loop answers a bolus as signedbolus.
  resultText() {
    const [action, outcome = ""] = this.result.split(":");
    const name = action.replace("signed", "").replace("forced", "");
    const label =
      { mute: "Mute", carbs: "Carbs", override: "Override", temptarget: "Temp target", bolus: "Bolus" }[name] ||
      action;
    return [label, outcome === "ok" ? "done" : outcome, outcome === "ok"];
  }

  drawCgmStatus(x, y, width, height, drawBackground = true) {
    // Geometry and background are fixed for a layout; only the timestamp is
    // dynamic. Keep this strip narrow and behind the ring in graph mode.
    // For a minute after a request's answer, its action goes left and its
    // outcome takes the CGM time's place (red when not done): together they
    // don't fit before the ring.
    const answer = this.result && this.resultText();
    const value = answer ? answer[1] : this.readingTime();
    const right = x + width - 5;
    const textWidth = this.render.getTextWidth(value, this.fonts.status);
    if (drawBackground)
      this.render.fillRectangle(this.colors.ink, x, y, width, height);
    else
      this.render.fillRectangle(
        this.colors.ink,
        right - textWidth - 2,
        y,
        textWidth + 2,
        height
      );
    // The strip left of the CGM time holds IOB and COB (or the line the phone
    // chose), or for a minute a request's outcome; it is repainted on every
    // render so older text never shows through. It dims once the loop is stale.
    // The glucose ring's bottom covers the middle of the strip, so a line too long
    // for the space before it (ISF & target) comes as "left\tright": the second
    // part goes between the ring and the CGM time.
    // Up to the cleared CGM time, so a wider outcome before it leaves nothing.
    this.render.fillRectangle(this.colors.ink, x, y, right - textWidth - 2 - x, height);
    const { iob, cob } = this.state;
    const [left, rest = ""] = (
      (answer && `${answer[0]}:`) ||
      this.state.statusLine ||
      (iob == null ? "" : `${Number(iob).toFixed(1)} U`) + (cob == null ? "" : `  ${Math.round(cob)} g`)
    ).split("\t");
    const color = !answer && this.loopFreshness() > 1 ? this.colors.dim : this.colors.white;
    const restX = Math.round(width * 0.48) + 34;
    this.text(left, this.fonts.status, color, x + 5, y + 1);
    this.text(rest, this.fonts.status, color, restX, y + 1);
    // Round screens have no free corner, so the loop ring sits on the strip.
    if (screen.round)
      this.drawLoopRing(restX + 8 + this.render.getTextWidth(rest, this.fonts.status), y + 2, this.colors.ink, this.colors.white);

    this.text(
      value,
      this.fonts.status,
      answer && !answer[2] ? this.colors.low : this.colors.white,
      right - textWidth,
      y + 1
    );
  }

  footer(width, height, footerHeight, now) {
    const clock = `${String(now.getHours()).padStart(2, "0")}:${String(
      now.getMinutes()
    ).padStart(2, "0")}`;
    this.render.fillRectangle(
      this.colors.ink,
      0,
      height - footerHeight,
      width,
      footerHeight
    );
    this.text(
      `${DAYS[now.getDay()]} ${now.getDate()}`,
      this.fonts.label,
      this.colors.pale,
      5,
      height - footerHeight + 5
    );
    const clockWidth = this.render.getTextWidth(clock, this.fonts.footer);
    this.text(
      clock,
      this.fonts.footer,
      this.colors.white,
      (width >> 1) - (clockWidth >> 1),
      height - footerHeight
    );
    const battery = `${this.state.battery}%`;
    const batteryWidth = this.render.getTextWidth(battery, this.fonts.label);
    const batteryLeft = width - 5 - batteryWidth;
    this.text(
      battery,
      this.fonts.label,
      this.colors.pale,
      batteryLeft,
      height - footerHeight + 5
    );
    if (!this.isConnected) {
      this.drawBluetoothDisconnectedIndicator(
        Math.round((width + clockWidth) / 2) + 4,
        height - 24
      );
    }
    this.footerState = {
      clock,
      date: `${DAYS[now.getDay()]} ${now.getDate()}`,
      battery,
      batteryWidth,
      clockWidth,
      connected: this.isConnected,
    };
  }

  drawBluetoothDisconnectedIndicator(x, y) {
    if (this.isConnected) return;

    const blue = this.colors.bluetooth;
    this.render.drawCircle(blue, x + 8, y + 8, 8, 0, 360);
    this.render.drawLine(x + 8, y + 2, x + 8, y + 14, this.colors.white, 1);
    this.render.drawLine(x + 8, y + 2, x + 12, y + 6, this.colors.white, 1);
    this.render.drawLine(x + 12, y + 6, x + 5, y + 12, this.colors.white, 1);
    this.render.drawLine(x + 5, y + 5, x + 12, y + 11, this.colors.white, 1);
    this.render.drawLine(x + 12, y + 11, x + 8, y + 14, this.colors.white, 1);
    this.render.drawLine(x + 1, y + 1, x + 15, y + 15, this.colors.crimson, 2);
  }

  // Complete watchface layouts

  fullScreenFace(width, height, footerHeight, now, drawFooter, preserveStatic) {
    const contentHeight = height - footerHeight;
    const cx = width >> 1;
    const radius = (width >> 1) - 9;
    const cy = contentHeight - radius;
    if (!preserveStatic) this.render.fillRectangle(this.colors.pale, 0, 0, width, height);
    this.drawVariantRing(cx, cy, radius);
    this.drawGlucose(cx, cy - 23, this.fonts.fullGlucose);
    this.text(
      this.deltaText(),
      this.fonts.delta,
      this.stale ? this.colors.low : this.colors.ink,
      cx,
      cy + 14,
      true
    );
    // Large Glucose has no status strip, so a request's answer takes the
    // reading time's place for its minute (red when not done).
    const answer = this.result && this.resultText();
    this.text(
      answer ? `${answer[0]}: ${answer[1]}` : this.readingTime(),
      this.fonts.status,
      this.stale || (answer && !answer[2]) ? this.colors.low : this.colors.ink,
      cx,
      cy + 39,
      true
    );
    if (!this.stale)
      this.arrow(
        cx + Math.round(radius * 0.67),
        cy,
        this.state.direction,
        this.colors.crimson,
        @FULL_ARROW_SCALE@
      );
    if (drawFooter) this.footer(width, height, footerHeight, now);
  }

  face(drawFooter = true, preserveStatic = false) {
    const { width, height } = this.render;
    const footerHeight = 30;
    const headerHeight = Math.round(height * 0.54);
    const now = new Date();
    if (this.hostChange || this.newProtocol) {
      this.warningScreen(width, height);
      return;
    }
    if (!this.configurationKnown) {
      this.connectingScreen(width, height);
      return;
    }
    if (!this.state.configured) {
      this.setupScreen(width, height);
      return;
    }

    if (this.state.fullScreen) {
      this.fullScreenFace(width, height, footerHeight, now, drawFooter, preserveStatic);
      return;
    }
    const radius = Math.min(58, Math.round(headerHeight * 0.47));
    const cx = Math.round(width * 0.48);
    const cy = Math.round(headerHeight / 2);
    const statusHeight = 17;
    const statusY = cy + radius - 14;
    const graphY = statusY + statusHeight;
    if (!preserveStatic) this.render.fillRectangle(this.colors.pale, 0, 0, width, height);
    this.drawCgmStatus(0, statusY, width, statusHeight, !preserveStatic);
    this.drawVariantRing(cx, cy, radius, this.state.closedLoop === 0);

    this.drawGlucose(cx, cy - 23, this.fonts.fullGlucose);
    this.text(
      this.deltaText(),
      this.fonts.delta,
      this.stale ? this.colors.low : this.colors.ink,
      cx,
      cy + 14,
      true
    );
    // The arrow sits outside the ring's redrawn circle, so nothing else
    // repaints this spot on a content-only render; clear it every time or a
    // direction change leaves the old glyph's strokes mixed with the new one.
    const arrowCx = width - 21;
    const arrowClearRadius = 20;
    this.render.fillRectangle(
      this.colors.pale,
      arrowCx - arrowClearRadius,
      cy - arrowClearRadius,
      arrowClearRadius * 2,
      arrowClearRadius * 2
    );
    if (!this.stale) this.arrow(arrowCx, cy, this.state.direction, this.colors.crimson);
    if (!screen.round) {
      this.render.fillRectangle(this.colors.pale, width - 45, 4, 45, 24);
      this.drawLoopRing(width - 42, 10, this.colors.pale, this.colors.ink);
    }
    this.statusY = statusY;
    this.loopFresh = this.loopFreshness();

    this.graph(0, graphY, width, height - graphY - footerHeight);
    if (drawFooter) this.footer(width, height, footerHeight, now);
  }

  // @endif
  // Full-render scheduling and recovery

  requestRender(priority, delay = 0, minuteDate = null) {
    if (priority >= 3) this.pendingFullRender = true;
    else if (priority === 2) {
      this.pendingMinuteRender = true;
      if (minuteDate) this.pendingMinuteDate = minuteDate;
    }
    this.pendingRenderDelay = Math.max(this.pendingRenderDelay, Math.max(0, delay));
    if (this.renderBusy || this.renderTimer) return;

    this.renderTimer = setTimeout(() => {
      this.renderTimer = null;
      if (this.renderBusy) return;
      const full = this.pendingFullRender;
      const minute = this.pendingMinuteRender;
      const minuteDate = this.pendingMinuteDate;
      this.pendingFullRender = false;
      this.pendingMinuteRender = false;
      this.pendingMinuteDate = null;
      this.pendingRenderDelay = 0;
      this.renderBusy = true;
      try {
        // Both are serviced when coalesced: a full/content draw never touches
        // the footer band, so a footer-only request (e.g. connection status)
        // must still run drawMinuteNow() even after drawNow() ran.
        if (full) this.drawNow();
        if (minute) this.drawMinuteNow(minuteDate);
      } finally {
        this.renderBusy = false;
        if (this.pendingFullRender || this.pendingMinuteRender)
          this.requestRender(this.pendingFullRender ? 3 : 2);
      }
    }, this.pendingRenderDelay);
  }

  draw() {
    this.requestRender(3);
  }

  recoverRender(_) {
    this.countDiagnostic("renderFailures");
    this.renderRetryCount += 1;
    if (this.renderRetryCount > 1) return;
    this.countDiagnostic("renderRetries");
    const delay = 1000;
    this.requestRender(3, delay);
  }

  drawNow() {
    const startedAt = Date.now();
    let contentOnly =
      this.state.configured &&
      this.hasRenderedConfiguredFace &&
      this.lastRenderedFullScreen === this.state.fullScreen;
    // The warning screen covers the footer too.
    if (this.hostChange || this.newProtocol) contentOnly = false;
    // @if helper
    // The remote shows one whole screen at a time and repaints all of it.
    contentOnly = false;
    // @endif
    const invalidatedPixels =
      this.render.width * (contentOnly ? this.render.height - 30 : this.render.height);
    let began = false;
    try {
      if (contentOnly)
        this.render.begin(0, 0, this.render.width, this.render.height - 30);
      else this.render.begin();
      began = true;
      this.face(!contentOnly, contentOnly);
      began = false;
      this.render.end();
      this.hasRenderedConfiguredFace = this.state.configured;
      // The warning screen isn't the face: the first draw after it repaints all of it.
      if (this.hostChange || this.newProtocol) this.hasRenderedConfiguredFace = false;
      this.lastRenderedFullScreen = this.state.fullScreen;
      this.recordDraw("full", startedAt, invalidatedPixels);
      this.renderRetryCount = 0;
    } catch (error) {
      this.recordDraw("full", startedAt, invalidatedPixels);
      if (began) {
        began = false;
        try {
          this.render.end();
        } catch (_) {
          // The failed frame may no longer be active.
        }
      }
      // Never begin a fallback transaction immediately after a display error.
      this.recoverRender(error);
    }
  }

  // Minute-only partial rendering

  drawMinute(event) {
    if (!this.state.configured) return;
    // The alarm buzz every minute while the warning screen shows.
    if (this.hostChange || this.newProtocol) vibe();
    const date = event && event.date ? event.date : new Date();
    const now = date.getTime();
    // @if helper
    // @else
    this.ensureDiagnosticsWindow();
    if (this.lastMinuteEventAt) {
      const late = Math.max(0, now - this.lastMinuteEventAt - 60000);
      this.diagnostics.minuteEventLateMs += late;
      this.diagnostics.minuteEventLateMaxMs = Math.max(
        this.diagnostics.minuteEventLateMaxMs,
        late
      );
      if (late >= 1000) this.countDiagnostic("lateMinuteEvents");
    }
    this.lastMinuteEventAt = now;
    // @endif
    // A request's outcome shows for a minute (or until the next reading), so a
    // CGM gap can't leave it on screen.
    if (this.result && now >= this.resultUntil) {
      this.result = null;
      this.requestRender(3);
    }
    // @if helper
    // @else
    if (now - this.lastBatterySampleAt >= BATTERY_SAMPLE_INTERVAL_MS) {
      this.updateBattery();
      this.lastBatterySampleAt = now;
    }
    if (!this.telemetryPending && now - this.lastTelemetrySentAt >= DIAGNOSTICS_INTERVAL_MS) {
      // Mark telemetry due without forcing its own write; let it ride the
      // next outbound message (a refresh request or onWritable flush).
      this.telemetryPending = true;
      this.telemetryDueAt = now;
    }
    if (
      this.telemetryPending &&
      now - this.telemetryDueAt >= DIAGNOSTICS_PIGGYBACK_GRACE_MS
    )
      this.flushOutbound();
    // @endif
    const staleChanged = this.updateStaleState(now);
    this.requestRender(staleChanged ? 3 : 2, 0, date);
  }

  // @if helper
  // No footer: the remote repaints its screen (it does every second anyway).
  drawMinuteNow() {
    this.drawNow();
  }

  // @else
  drawMinuteNow(minuteDate = null) {
    if (!this.state.configured) return;
    if (this.hostChange || this.newProtocol) return;
    const startedAt = Date.now();
    const footerHeight = 30;
    const footerY = this.render.height - footerHeight;
    const width = this.render.width;
    const date = minuteDate || new Date();
    const clock = `${String(date.getHours()).padStart(2, "0")}:${String(
      date.getMinutes()
    ).padStart(2, "0")}`;
    const dateText = `${DAYS[date.getDay()]} ${date.getDate()}`;
    const battery = `${this.state.battery}%`;
    const checkMinute = Boolean(minuteDate);
    const clockChanged = checkMinute && clock !== this.footerState.clock;
    const dateChanged = checkMinute && dateText !== this.footerState.date;
    const batteryChanged = checkMinute && battery !== this.footerState.battery;
    const connectionChanged = this.isConnected !== this.footerState.connected;
    let invalidatedPixels = 0;
    let began = false;
    try {
      const redraw = (x, regionWidth, draw) => {
        this.render.begin(x, footerY, regionWidth, footerHeight);
        began = true;
        this.render.fillRectangle(this.colors.ink, x, footerY, regionWidth, footerHeight);
        draw();
        began = false;
        this.render.end();
        invalidatedPixels += regionWidth * footerHeight;
      };
      if (dateChanged)
        redraw(0, 58, () =>
          this.text(dateText, this.fonts.label, this.colors.white, 5, footerY + 5)
        );
      if (clockChanged) {
        const clockWidth = this.render.getTextWidth(clock, this.fonts.footer);
        // Clear the wider of the old and new clock so a narrower new value can
        // never leave the previous glyph's outer edges behind.
        const clearWidth = Math.max(clockWidth, this.footerState.clockWidth || 0) + 2;
        const clearX = Math.round(width / 2 - clearWidth / 2);
        redraw(clearX, clearWidth, () =>
          this.text(clock, this.fonts.footer, this.colors.white, width / 2, footerY, true)
        );
        this.footerState.clockWidth = clockWidth;
      }
      if (batteryChanged) {
        const batteryWidth = this.render.getTextWidth(battery, this.fonts.label);
        const clearWidth = Math.max(batteryWidth, this.footerState.batteryWidth) + 2;
        const batteryLeft = width - 5 - batteryWidth;
        redraw(width - 5 - clearWidth, clearWidth, () =>
          this.text(battery, this.fonts.label, this.colors.white, batteryLeft, footerY + 5)
        );
        this.footerState.batteryWidth = batteryWidth;
      }
      if (connectionChanged) {
        const clockWidth = this.render.getTextWidth(clock, this.fonts.footer);
        const indicatorX = Math.round((width + clockWidth) / 2) + 4;
        redraw(indicatorX, 18, () =>
          this.drawBluetoothDisconnectedIndicator(indicatorX, this.render.height - 24)
        );
      }
      // The loop age changes every minute; a change in freshness also dims or
      // brightens IOB/COB, so that one redraws the whole face.
      if (checkMinute && !this.state.fullScreen && this.statusY) {
        if (this.loopFreshness() !== this.loopFresh) this.requestRender(3);
        else if (screen.round) {
          this.render.begin(0, this.statusY, width, 17);
          began = true;
          this.drawCgmStatus(0, this.statusY, width, 17);
          began = false;
          this.render.end();
          invalidatedPixels += width * 17;
        } else {
          this.render.begin(width - 45, 4, 45, 24);
          began = true;
          this.render.fillRectangle(this.colors.pale, width - 45, 4, 45, 24);
          this.drawLoopRing(width - 42, 10, this.colors.pale, this.colors.ink);
          began = false;
          this.render.end();
          invalidatedPixels += 45 * 24;
        }
      }
      if (checkMinute) {
        this.footerState.clock = clock;
        this.footerState.date = dateText;
        this.footerState.battery = battery;
      }
      this.footerState.connected = this.isConnected;
      this.recordDraw("minute", startedAt, invalidatedPixels);
      this.renderRetryCount = 0;
    } catch (error) {
      this.recordDraw("minute", startedAt, invalidatedPixels);
      if (began) {
        began = false;
        try {
          this.render.end();
        } catch (_) {
          // The failed frame may no longer be active.
        }
      }
      this.recoverRender(error);
    }
  }

  // @endif
  // Watch hardware services

  // @if helper
  // @else
  startBatteryService() {
    try {
      // Sample on the existing minute wake-up rather than keeping a battery
      // service callback subscribed for the lifetime of the watchface.
      this.battery = new Battery({});
      this.updateBattery();
      this.lastBatterySampleAt = Date.now();
    } catch (_) {
      // Battery data is optional.
    }
  }

  updateBattery() {
    const sample = this.battery.sample();
    if (!sample || sample.percent == null || sample.percent === this.state.battery)
      return false;
    this.state.battery = sample.percent;
    return true;
  }

  // @endif
  // Watch-to-phone messaging

  startMessageService() {
    try {
      this.message = new Message({
        keys: ["COMMAND", "DATA", "ERROR", "CONFIGURED", "DIAGNOSTICS", "RESULT"],
        onReadable: () => this.readMessages(),
        onWritable: () => this.setPhoneConnected(true),
        onSuspend: () => this.setPhoneConnected(false),
      });
      // onWritable may run synchronously inside the constructor, before the
      // Message instance has been assigned to this.message.
      this.flushOutbound();
    } catch (_) {
      // The service remains unavailable until the watchface restarts.
    }
  }

  requestDataRefresh() {
    this.refreshPending = true;
    this.flushOutbound();
  }

  // @if helper
  // @else
  requestDiagnostics() {
    this.telemetryPending = true;
    this.flushOutbound();
  }

  // @endif
  checkConnection() {
    const isConnected = Boolean(watch.connected && watch.connected.app);
    console.log(`Connected: ${isConnected}`);
    this.setPhoneConnected(isConnected);
  }

  setPhoneConnected(connected) {
    // @if demoTestOnly
    connected = true;
    // @endif
    if (connected === this.isConnected) {
      if (connected) this.flushOutbound();
      return;
    }
    // @if helper
    this.isConnected = connected;
    if (connected) this.flushOutbound();
    // @else
    const now = Date.now();
    this.isConnected = connected;
    if (connected) {
      const duration = this.phoneDisconnectedAt
        ? Math.max(0, now - this.phoneDisconnectedAt)
        : 0;
      this.addDiagnostic("phoneDisconnectedMs", duration);
      this.diagnostics.phoneDisconnectedMaxMs = Math.max(
        this.diagnostics.phoneDisconnectedMaxMs,
        duration
      );
      this.phoneDisconnectedAt = 0;
      this.flushOutbound();
    } else {
      this.phoneDisconnectedAt = now;
      this.countDiagnostic("phoneDisconnects");
    }
    // @endif
    this.requestRender(2);
  }

  // Signs "<action>:<units>[:<grams>]" with the phone's session key and sends
  // it; without a key (the phone sends one only while it may take boluses from
  // this watch) nothing is sent. A failed write keeps the signed command, so a
  // resend has the same sequence and confirmation time.
  requestSignedBolus(request) {
    const auth = this.bolusAuth;
    if (!auth) {
      this.result = "bolus:no key";
      this.resultUntil = Date.now() + 60000;
      Vibes.doublePulse();
      this.requestRender(2);
      return;
    }
    const [action, units, grams] = request.split(":");
    const confirmedAt = Math.floor(Date.now() / 1000);
    auth.seq += 1;
    const mac = bolusMac(
      auth.key,
      `v1|${auth.sid}|${auth.seq}|${confirmedAt}|${action}|${units}|${grams || ""}`
    );
    this.bolusCommand = `${request}@${confirmedAt}#${auth.sid}.${auth.seq}.${mac}`;
    this.flushOutbound();
  }

  // @if allowShakeDebugActionTestOnly
  requestShakeDebugAction() {
    // Feel and see that the shake registered; a RESULT from the phone replaces it.
    Vibes.shortPulse();
    this.result = `sent ${SHAKE_DEBUG_ACTION}`;
    this.resultUntil = Date.now() + 60000;
    this.requestRender(2);
    if (SHAKE_DEBUG_ACTION.startsWith("signed")) {
      this.requestSignedBolus(SHAKE_DEBUG_ACTION);
      return;
    }
    this.bolusCommand = `${SHAKE_DEBUG_ACTION}@${Math.floor(Date.now() / 1000)}`;
    this.flushOutbound();
  }

  // @endif
  flushOutbound() {
    // @if demoTestOnly
    const request = this.bolusCommand;
    this.bolusCommand = null;
    this.refreshPending = false;
    // "mute:30@…" answers "mute:ok", "signedbolus:0.5@…#…" "signedbolus:ok";
    // like the phone, a bolus with carbs ("signedbolus:0.5:10@…") is answered
    // "carbs:ok" first. Nothing is left pending, so the real send below returns at once.
    if (request) {
      const [action, , grams] = request.split("@")[0].split(":");
      const answers = grams ? ["carbs:ok", `${action}:ok`] : [`${action}:ok`];
      answers.forEach((answer, index) => setTimeout(() => demoReceive(this, [["RESULT", answer]]), 3000 * (index + 1)));
    }
    // @endif
    // @if helper
    if ((!this.refreshPending && !this.bolusCommand) || !this.message) return;
    // @else
    if ((!this.refreshPending && !this.telemetryPending && !this.bolusCommand) || !this.message)
      return;
    // @endif
    const values = [];
    // A bolus request takes the COMMAND key; a pending refresh follows it.
    const bolus = this.bolusCommand;
    if (bolus || this.refreshPending) values.push(["COMMAND", bolus || "refresh"]);
    // @if helper
    // @else
    if (this.telemetryPending)
      values.push(["DIAGNOSTICS", JSON.stringify(this.diagnosticsSnapshot())]);
    // @endif
    try {
      this.message.write(new Map(values));
      // @if helper
      // @else
      this.countDiagnostic("outgoingMessages");
      this.addDiagnostic(
        "outgoingBytes",
        values.reduce(
          (total, entry) => total + String(entry[0]).length + String(entry[1]).length,
          0
        )
      );
      // @endif
      if (bolus) this.bolusCommand = null;
      else
      if (this.refreshPending) {
        this.refreshPending = false;
        this.lastRefreshRequestedAt = Date.now();
        this.refreshStartedAt = this.lastRefreshRequestedAt;
        this.countDiagnostic("refreshRequests");
      }
      // @if helper
      // @else
      if (this.telemetryPending) {
        this.telemetryPending = false;
        this.lastTelemetrySentAt = Date.now();
      }
      // @endif
    } catch (_) {
      // Alloy turns writes off whenever the phone's app session (Loop's, not the
      // Pebble app's) opens or closes, and only a new Message turns them back on.
      // Reopen it, at most every 30 s; the new one sends what is pending. Not
      // before the first message from the phone: until then writes wait for the
      // startup handshake, and reopening would drop the phone's first reply.
      if (this.lastDataSignature && Date.now() - (this.reopenedAt || 0) > 30000) {
        this.reopenedAt = Date.now();
        this.message.close();
        this.startMessageService();
        return;
      }
      // Keep the request pending. onWritable will retry it when the outbox is
      // actually available, without starting a continuous refresh loop.
      this.countDiagnostic("refreshDeferred");
    }
  }

  // Glucose alarms

  updateStaleState(now = Date.now()) {
    const updated = Number(this.state.updated);
    const age =
      Number.isFinite(updated) && updated > 0 ? Math.max(0, now - updated) : 0;
    const stale = age >= 15 * 60 * 1000;
    // @if helper
    // @else
    if (stale) {
      this.ensureDiagnosticsWindow();
      this.diagnostics.staleAgeMaxMs = Math.max(this.diagnostics.staleAgeMaxMs, age);
    }
    // @endif
    if (stale === this.stale) return false;

    this.stale = stale;
    if (stale) {
      this.countDiagnostic("staleTransitions");
      // The no-recent-data buzz ignores Loop's alarm mask, which is 0 while
      // Loop's alerts are muted or watch alarms are off.
      // @if helper
      // (Not in the remote: the watchface gives that alarm, and the status line
      // says so.)
      // @else
      {
        this.countDiagnostic("staleAlarms");
        Vibes.shortPulse();
      }
      // @endif
    }
    return true;
  }


  // Host-issued alerts: Loop/Trio evaluate their own alerts. DATA index 8 is the
  // highest active level; index 9 is an alert event the host advances on every
  // fire, including repeats of an alert that is still active. The watch buzzes
  // when the event changes while the level is above 0, so it repeats in step
  // with the host and stops when the user acknowledges on the phone. The event
  // is recorded on every message, even while silent (watch alarms off sends
  // level 0), and the first one after a start is recorded without buzzing.
  // Any level gets the full glucose-alarm buzz: without the iOS critical-alert
  // entitlement, urgent alerts arrive at warning level.
  //
  // PebbleOS drops an app's buzz while another vibration plays and cancels it
  // when a system pop-up closes, without telling the app. The last 5 buzzes
  // are kept in the diagnostics as [event, level, start time, outcome] so a
  // missed one can be matched to a pop-up: outcome -2 vibe() failed, -1 not
  // covered, 0 already covered, otherwise the ms into the buzz a pop-up covered
  // the face. Events that arrive at level 0 (Watch Alarms off) are counted.
  // Loop's freshness thresholds (LoopCompletionFreshness): fresh up to 6
  // minutes, aging up to 16, stale after that or when unknown.
  loopFreshness() {
    const age = Date.now() - Number(this.state.lastLoop);
    return !this.state.lastLoop ? 2 : age <= 360000 ? 0 : age <= 960000 ? 1 : 2;
  }

  // Loop's status ring with the minutes since the last loop: a full ring when
  // the loop is closed, a 90° gap at the top when it is open (as Loop), coloured
  // by freshness.
  // Nothing when the host sends no loop status.
  drawLoopRing(x, y, background, textColor) {
    const { lastLoop, closedLoop } = this.state;
    if (lastLoop == null && closedLoop == null) return;
    const r = 6;
    const minutes = Math.max(0, Math.floor((Date.now() - lastLoop) / 60000));
    const color = this.colors.loop[this.loopFreshness()];
    if (closedLoop === 0) this.render.drawCircle(color, x + r, y + r, r, 45, 315);
    else this.render.drawCircle(color, x + r, y + r, r, 0, 360);
    this.render.drawCircle(background, x + r, y + r, r - 2, 0, 360);
    this.text(
      !lastLoop ? "--" : minutes < 60 ? `${minutes}m` : `${Math.floor(minutes / 60)}h`,
      this.fonts.status,
      textColor,
      x + 2 * r + 3,
      y - 3
    );
  }

  checkHostAlert() {
    const event = this.state.alertEvent;
    // @if helper
    // The same buzz as Luped, without its buzz history.
    if (this.lastAlertEvent !== undefined && event !== this.lastAlertEvent && this.state.hostAlertState > 0)
      vibe();
    // @else
    if (this.lastAlertEvent !== undefined && event !== this.lastAlertEvent) {
      if (this.state.hostAlertState > 0) {
        const buzz = [event, this.state.hostAlertState, Date.now(), this.coveredAt ? 0 : -1];
        try {
          vibe();
        } catch (_) {
          buzz[3] = -2;
        }
        this.ensureDiagnosticsWindow();
        const buzzes = this.diagnostics.buzzes;
        buzzes.push(buzz);
        if (buzzes.length > 5) buzzes.shift();
      } else {
        this.countDiagnostic("silentAlertEvents");
      }
    }
    // @endif
    this.lastAlertEvent = event;
  }

  // Phone-to-watch messaging

  readMessages() {
    let receivedData = false;
    let needsFullDraw = false;
    // @if helper
    for (const [key, value] of this.message.read()) {
      if (key === "DATA") {
        // @else
    let incomingBytes = 0;
    for (const [key, value] of this.message.read()) {
      incomingBytes += String(key).length + String(value).length;
      if (key === "DATA") {
        this.countDiagnostic("dataMessages");
        if (this.refreshStartedAt) {
          const elapsed = Math.max(0, Date.now() - this.refreshStartedAt);
          this.countDiagnostic("refreshResponses");
          this.addDiagnostic("refreshResponseMs", elapsed);
          this.diagnostics.refreshResponseMaxMs = Math.max(
            this.diagnostics.refreshResponseMaxMs,
            elapsed
          );
          this.recordLatency(this.diagnostics.refreshResponseLatencyBuckets, elapsed);
          this.refreshStartedAt = 0;
        }
        // @endif
        try {
          // Minimal Luped protocol: [version, glucose, delta, trend, history,
          // unitsFlag, timestamp, fullScreen, hostAlertState, alertEvent, ...].
          // Alerts are host-issued (indexes 8-9). No thresholds travel and the
          // watch has none: index 8 (the active glucose alert) colours the ring.
          const values = JSON.parse(value);
          // A newer protocol (index 0) may give these indexes other meanings:
          // nothing is shown until the face is updated, or the phone goes back
          // to version 1.
          if (values[0] > 1) {
            if (!this.newProtocol) {
              needsFullDraw = true;
              vibe();
            }
            this.newProtocol = values[0];
            this.refreshPending = false;
            continue;
          }
          if (this.newProtocol) {
            this.newProtocol = 0;
            needsFullDraw = true;
          }
          const LUPED_DIRECTIONS = [
            "DoubleDown", "SingleDown", "FortyFiveDown", "Flat",
            "FortyFiveUp", "SingleUp", "DoubleUp",
          ];
          const mmol = values[5];
          const data = {
            glucose: values[1],
            delta: values[2],
            direction: LUPED_DIRECTIONS[values[3]] || "Flat",
            // @if helper
            // (No graph: the remote leaves the history out.)
            // @else
            readings: values[4] || [],
            // @endif
            units: mmol ? "mmol/L" : "mg/dL",
            updated: values[6],
            fullScreen: Boolean(values[7]),
            hostAlertState: values[8] || 0,
            alertEvent: values[9],
            // Loop status (null when the host sends none; absent from older hosts).
            iob: values[10],
            cob: values[11],
            lastLoop: values[12],
            closedLoop: values[13],
            // A status line the phone formatted (temp basal, eventual glucose,
            // ISF & target); null means IOB and COB, formatted here.
            statusLine: values[14],
          };
          // The first host app named (index 15) is the one this run follows;
          // a different one later means two phone apps share the watch, so
          // the face stops showing data until it is restarted.
          const host = values[15];
          if (host != null && this.host == null) this.host = host;
          else if (host != null && host !== this.host && !this.hostChange) {
            this.hostChange = [this.host, host];
            this.bolusAuth = null;
            needsFullDraw = true;
            vibe();
          }
          const signature = JSON.stringify(data);
          const readingAdvanced = Number(data.updated) !== Number(this.state.updated);
          needsFullDraw =
            needsFullDraw ||
            signature !== this.lastDataSignature ||
            this.state.error != null;
          this.lastDataSignature = signature;
          Object.assign(this.state, data, { error: null });
          if (readingAdvanced) this.lastRefreshRequestedAt = 0;
          // @if helper
          // (The remote keeps an answer on screen when a new reading arrives.)
          // @else
          if (readingAdvanced) this.result = null;
          // @endif
          this.refreshPending = false;
          needsFullDraw = this.updateStaleState() || needsFullDraw;
          receivedData = true;
        } catch (_) {
          needsFullDraw = needsFullDraw || this.state.error !== "Bad response";
          this.state.error = "Bad response";
        }
      } else if (key === "ERROR") {
        this.refreshPending = false;
        this.refreshStartedAt = 0;
        needsFullDraw = needsFullDraw || this.state.error !== value;
        this.state.error = value;
      } else if (key === "RESULT") {
        // @if helper
        // A bolus with carbs is answered twice, carbs first: that answer doesn't
        // end the wait (so nothing reads as done before the bolus is), and the
        // wait starts again for the bolus, which comes after a new bolus context.
        if (this.pending && this.pending.action === "bolus" && value.startsWith("carbs:")) {
          this.pending.carbs = value.split(":")[1];
          this.pending.until = Date.now() + RESULT_TIMEOUT_MS;
          needsFullDraw = true;
          continue;
        }
        // @endif
        // The phone's "<action>:<outcome>" for a watch request (on the watchface
        // too when Luped Remote closed before the answer), shown for a minute or
        // until the next reading: a long buzz when it was carried out (unlike
        // the remote's short "sent" buzz), a double buzz when it wasn't.
        this.result = value;
        this.resultUntil = Date.now() + 60000;
        if (value.endsWith(":ok")) Vibes.longPulse();
        else Vibes.doublePulse();
        needsFullDraw = true;
        // @if helper
        // The answer ends the wait: show it (the buzz above tells the wearer),
        // and leave time to read it before closing.
        if (this.pending) this.view = "result";
        this.pending = null;
        this.secondsLeft = Math.max(this.secondsLeft, 15);
        // @endif
      } else if (key === "CONFIGURED") {
        const configured = Boolean(value);
        needsFullDraw =
          needsFullDraw ||
          !this.configurationKnown ||
          this.state.configured !== configured;
        this.configurationKnown = true;
        this.state.configured = configured;
      } else if (key === "COMMAND" && value.startsWith("auth:v1:") && !this.hostChange) {
        // The phone's session key for signed boluses, kept in memory only: a
        // restart forgets it and the phone sends a new one.
        const [, , sid, keyHex] = value.split(":");
        this.bolusAuth = { sid, key: hmacKey(hexBytes(keyHex)), seq: 0 };
        // @if helper
      }
    }
    // @else
      } else if (key === "COMMAND" && value === "diagnostics") {
        this.requestDiagnostics();
      } else if (key === "COMMAND" && value === "diagnostics-reset") {
        this.resetDiagnostics();
      }
    }
    this.countDiagnostic("incomingMessages");
    this.addDiagnostic("incomingBytes", incomingBytes);
    // @endif
    // Process the response first so reconnect flushing cannot resend a request
    // that this message has already satisfied.
    this.setPhoneConnected(true);
    if (receivedData) {
      this.checkHostAlert();
    }
    if (needsFullDraw) this.draw();
  }
}

new CrimsonBearWatchface().start();
